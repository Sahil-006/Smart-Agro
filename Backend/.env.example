# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Flask secret key for session signing
FLASK_SECRET_KEY=your-secure-random-secret-key-here

# Frontend application URL for CORS and password reset links
FRONTEND_URL=http://localhost:5173

# Server port
PORT=5001

# Gmail SMTP credentials for sending password reset emails
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google OAuth Client ID for verifying ID tokens
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# GitHub OAuth credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

